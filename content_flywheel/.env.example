# content_flywheel 配置(复制为 .env 后填真实值)

# ── LLM 生成(OpenAI 兼容接口: DeepSeek 网关 / 官方 / 中转均可) ──
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o

# ── X 全自动发布(Buffer, 双账号) ──
# 旧 token 已在聊天泄露作废, 请先去 Buffer 后台重置
BUFFER_TOKEN=
BUFFER_PROFILE_ID_TECH=      # X 技术号 profile (tech 线程)
BUFFER_PROFILE_ID_CRYPTO=    # X 区块链号 profile (crypto 内容)
AUTO_PUSH_X=false

# ── 流量回流阈值(reads 达标 → 归档+衍生选题) ──
FEEDBACK_THRESHOLD=1000
